# MODELO das chaves. NÃO coloque chave real aqui.
# Para usar: copie este arquivo para config/chaves.env (mesmo lugar) e preencha lá.
# O arquivo chaves.env está no .gitignore: nunca vai para o git.
# NUNCA cole uma chave no chat do Claude.
#
# O Motor A (gravação real) NÃO precisa de nenhuma chave.
# Estas só são necessárias se você ligar o Motor B ("usa o motor B nesta VSL")
# ou o B-roll por IA num projeto.

# ElevenLabs — clone da sua voz (Motor B)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# fal.ai — avatar com lip-sync (Motor B) e B-roll por IA (opcional)
FAL_KEY=

# HeyGen — alternativa à fal.ai para o avatar (Motor B, opcional)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
